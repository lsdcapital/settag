{
  "name": "settag-site",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "update": "pnpm up -i -L",
    "whoami": "doppler run --project settag --config prod -- wrangler whoami",
    "deploy": "pnpm run build && doppler run --project settag --config prod -- wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.159.0"
  },
  "packageManager": "pnpm@11.25.0"
}
